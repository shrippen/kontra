{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Manifest",
  "description": "`manifest.json` of a `.kontra` package (`FORMAT.md`).",
  "type": "object",
  "properties": {
    "artist": {
      "type": "string",
      "default": ""
    },
    "backing": {
      "anyOf": [
        {
          "$ref": "#/$defs/PackageBacking"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "format": {
      "type": "string"
    },
    "loops": {
      "description": "Practice loops the sender set for the piece.",
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/PackageLoop"
      }
    },
    "score": {
      "description": "File name of the score under `score/`.",
      "type": "string"
    },
    "target_speed": {
      "description": "Target speed of the workshop, 1.0 = as written; `None`: as written.",
      "type": [
        "number",
        "null"
      ],
      "format": "double",
      "default": null
    },
    "title": {
      "type": "string"
    },
    "track": {
      "description": "Track of the score that is played.",
      "type": "integer",
      "format": "uint",
      "default": 0,
      "minimum": 0
    },
    "version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    }
  },
  "required": [
    "format",
    "version",
    "title",
    "score"
  ],
  "$defs": {
    "PackageBacking": {
      "description": "The backing track: inside the package or a path on the author's computer.",
      "oneOf": [
        {
          "description": "`audio/<file>` in the package.",
          "type": "object",
          "properties": {
            "file": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "embedded"
            },
            "offset_s": {
              "type": "number",
              "format": "double"
            }
          },
          "required": [
            "kind",
            "file",
            "offset_s"
          ]
        },
        {
          "description": "Not included; the receiver chooses their own copy.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "linked"
            },
            "offset_s": {
              "type": "number",
              "format": "double"
            },
            "path": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "path",
            "offset_s"
          ]
        }
      ]
    },
    "PackageLoop": {
      "description": "A practice loop: bars `from..=to`, indices from 0 into the bars with repeats unrolled.",
      "type": "object",
      "properties": {
        "from": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "to": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        }
      },
      "required": [
        "from",
        "to"
      ]
    }
  }
}
